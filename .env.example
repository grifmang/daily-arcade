# Daily Arcade — environment variables (names + safe placeholders only)
# Copy to .env.local for local development.
# In production, set via `netlify env:set` or the Netlify UI. Real secret
# values are NEVER written to this file or any committed file.
# See DECISIONS.md ADR-4 (2026-04-30) for the full env contract.

# Postgres (Neon, direct project — not Netlify Marketplace).
# Leave unset for local dev to run with InMemoryStore.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# 64-byte hex; rotated quarterly. Used to sign share/OG URLs.
SHARE_SIGNING_SECRET=

# 32-byte hex; bearer for /api/cron/daily-warm (called by Netlify Scheduled Function).
CRON_SECRET=

# 64-byte hex; HMAC base for daily IP-hash salts (privacy-respecting rate-limit).
IP_HASH_SALT_BASE=

# Cloudflare Turnstile (bot protection on submitScore + claimHandle Server Actions).
# Public site key — embedded in client bundle. Server-only secret key — never
# in client. In NODE_ENV !== "production", lib/turnstile.ts substitutes the
# Cloudflare always-pass test keys so dev + deploy previews work without
# real keys. See DECISIONS.md ADR-1 (2026-04-30).
TURNSTILE_SITE_KEY=<your-turnstile-site-key>
TURNSTILE_SECRET_KEY=<your-turnstile-secret-key>

# Optional: opt in to Netlify skew protection. Recommended for production.
# NETLIFY_NEXT_SKEW_PROTECTION=true
